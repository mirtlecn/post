# Redis connection URL redis://default:password@host:port
# e.g. redis://localhost:6379/0
# For TLS/SSL, use rediss:// instead of redis://
LINKS_REDIS_URL=redis://user:password@host:port/db-number

# Secret key for API authentication
SECRET_KEY=your-secret-key-here

# Admin GUI password
ADMIN_KEY=your-admin-password-here

# Public domain for generated links, without protocol or trailing slash
# e.g. www.example.com
# BASE_DOMAIN=

# Optional base64-encoded HTML footer for rendered Markdown pages
# Invalid base64 or blank decoded HTML is ignored.
# Generate with: printf '%s' '<footer html>' | base64 | tr -d '\n'
# FOOTER=

# Port | default is 3000
# PORT=3000

# Max text size in KB | default is 500kb
# MAX_CONTENT_SIZE_KB=500

# S3 Configuration (for file uploads)
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
#
# Browser direct uploads need bucket CORS. For R2/S3-compatible storage,
# allow the admin origin, PUT, and the Content-Type request header.
# Example AllowedOrigins: ["http://localhost:3000", "https://example.com"]

# S3 max file upload size in MB | default is 50mb
# MAX_FILE_SIZE_MB=50
