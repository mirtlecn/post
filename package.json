{
  "name": "post",
  "version": "1.5.5",
  "description": "A lightweight link shortener, pastebin and file sharing service",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node server.js",
    "dev:web": "vite",
    "start": "npm run build && npm run start:server",
    "start:server": "node server.js",
    "test": "node --test && bash test/functional/run-local.sh && bash test/functional/run-api-local.sh",
    "test:unit": "node --test",
    "test:smoke": "bash test/functional/run-local.sh && bash test/functional/run-api-local.sh",
    "version:bump": "node scripts/bump-version.mjs",
    "vercel": "vercel dev",
    "test:vercel": "bash test/functional/run-vercel.sh"
  },
  "keywords": [],
  "author": "Mirtle",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1003.0",
    "@fontsource-variable/public-sans": "^5.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formidable": "^3.5.4",
    "gfm-it": "^0.3.4",
    "lucide-react": "^1.18.0",
    "qrcode-terminal": "^0.12.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "redis": "^6.0.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.16"
  }
}
