{
  "name": "post",
  "version": "1.5.1",
  "description": "A lightweight link shortener, pastebin and file sharing service",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "assets:update": "node scripts/update-embedded-assets.mjs",
    "build": "vite build",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node server.js",
    "dev:web": "vite",
    "start": "npm run build && npm run start:server",
    "start:server": "node server.js",
    "test": "node --test && bash test/functional/run-local.sh && bash test/functional/run-api-local.sh",
    "test:unit": "node --test",
    "test:smoke": "bash test/functional/run-local.sh && bash test/functional/run-api-local.sh",
    "version:bump": "node scripts/bump-version.mjs",
    "vercel": "vercel dev",
    "test:vercel": "bash test/functional/run-vercel.sh"
  },
  "keywords": [],
  "author": "Mirtle",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1003.0",
    "@aws-sdk/s3-request-presigner": "3.1003.0",
    "formidable": "^3.5.4",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.3",
    "marked-highlight": "^2.2.3",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.16"
  }
}
